# .env.example

# Gemini API (무료) — 원고 생성용
GEMINI_API_KEY=your-gemini-api-key-here
# OpenAI API (미사용, Gemini 폴백 실패 시 대비용으로만 남겨둠)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Meta (Instagram/Facebook) Graph API — 앱 자격증명 (OAuth 로그인에 사용, /auth/meta/login)
# 실제 발행에 쓰이는 페이지/IG 액세스 토큰은 로그인 시 자동 발급/저장되므로 여기엔 앱 자격증명만 필요
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# 메타 앱의 "유효한 OAuth 리디렉션 URI"와 반드시 동일해야 함 (미설정 시 배포된 Render 주소가 기본값)
META_REDIRECT_URI=http://localhost:5000/auth/meta/callback
# 레거시 필드 (사용 안 함) — 예전에 정적 토큰을 직접 넣던 방식, 지금은 OAuth 로그인으로 대체됨
# INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
# INSTAGRAM_USER_ID=your-instagram-user-id

# Naver Blog API — 앱 자격증명 (OAuth 로그인에 사용, /auth/naver/login)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_BLOG_ID=your-naver-blog-id
# 참고: NAVER_REDIRECT_URI는 현재 config.py에 배포 주소로 직접 하드코딩되어 있어
# 여기에 값을 넣어도 적용되지 않음 (콜백 주소를 바꾸려면 config.py를 직접 수정)

# X (Twitter) API — OAuth 1.0a 사용자 토큰 (바로 즉시 발행 가능, 별도 로그인 불필요)
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# TikTok API — 앱 자격증명 (OAuth 로그인에 사용, /auth/tiktok/login)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# 참고: TIKTOK_REDIRECT_URI도 현재 config.py에 http://127.0.0.1:5000/... 으로 직접
# 하드코딩되어 있어 여기에 값을 넣어도 적용되지 않음 (틱톡 포털 리디렉션 검증 이슈로 임시 고정된 상태)

# Flask 설정
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-random-string
